# Copy to ~/.bashrc.local and fill in. That file is sourced by .bashrc before
# .bashrc.d/*.sh, and is never committed: use it for anything machine- or
# work-specific that shouldn't be in a public repo.

# These are used by .bashrc.d/*.sh, which ShellCheck can't see from here
# shellcheck disable=SC2034

# Name shown in the prompt. Leave empty for user@host
PROMPT_NAME="digital@wizzard"

# Notepad++, for `np` and `npbash`. Leave empty for C:\Program Files\Notepad++
NOTEPADPP=""

# Title of the report `nae` writes. Leave empty for "npm audit report"
AUDIT_TITLE=""

# Squiz DXP tenant used by `dxpa`, and component namespace used by `dxpnew`
export DXP_TENANT=""
DXP_NAMESPACE=""
# Required by dxp-next to deploy page layouts to Squiz Cloud (`dxpldeploy`)
export ENABLE_PAGE_LAYOUTS="true"
